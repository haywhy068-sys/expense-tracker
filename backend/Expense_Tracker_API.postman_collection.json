{
  "info": {
    "name": "Expense Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Auth > Register (or Login) first; the token is saved and used everywhere. Requests act on your Personal workspace unless they send an X-Workspace-Id header."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); const pad = n => String(n).padStart(2, \"0\");",
          "const today = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;",
          "pm.collectionVariables.set(\"today\", today);",
          "pm.collectionVariables.set(\"month\", today.slice(0, 7));",
          "pm.collectionVariables.set(\"monthStart\", today.slice(0, 7) + \"-01\");",
          "if (!pm.collectionVariables.get(\"email\")) pm.collectionVariables.set(\"email\", `postman${Date.now()}@example.com`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "expenseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created (201), or already exists (409) on a re-run\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "const j = pm.response.json(); if (j.access_token) pm.collectionVariables.set(\"token\", j.access_token);",
                  "if (pm.response.json().default_workspace_id) pm.collectionVariables.set(\"personalWorkspaceId\", pm.response.json().default_workspace_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json(); if (j.access_token) pm.collectionVariables.set(\"token\", j.access_token);",
                  "if (pm.response.json().default_workspace_id) pm.collectionVariables.set(\"personalWorkspaceId\", pm.response.json().default_workspace_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
