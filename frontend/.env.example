# API base path defaults to /api; development proxy forwards it to port 5000.
# Separate API example: http://localhost:5000/api
VITE_API_URL=/api
# Display currency for this ledger. The API has no currency field.
VITE_CURRENCY=NGN
# Mock data is enabled only with npm run dev:mock, and only in development.
VITE_MOCK_API=false
